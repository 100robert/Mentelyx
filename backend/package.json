{
  "name": "@mentelyx/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API Hono del monolito modular de Mentelyx en Cloudflare Workers (siete módulos, Clean Architecture)",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:verificar": "node scripts/verificar-migraciones.mjs",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "cf-typegen": "wrangler types --env-interface Env"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@mentelyx/contratos": "workspace:*",
    "@neondatabase/serverless": "1.2.1",
    "better-auth": "1.7.27",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "kysely": "0.29.9",
    "mongodb": "7.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.0",
    "@upstash/redis": "1.41.0",
    "drizzle-kit": "0.31.11",
    "pg": "8.23.1",
    "wrangler": "4.166.0"
  }
}
