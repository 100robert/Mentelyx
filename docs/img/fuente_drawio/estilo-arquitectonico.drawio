<mxCell id="c158" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:12.5px;font-weight:700;font-style:normal;color:#111111;font-family:Arial&quot;&gt;Red publicitaria / patrocinadores&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:10.5px;font-weight:400;font-style:normal;color:#222222;font-family:Arial&quot;&gt;Función: campañas y anuncios autorizados.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:10.5px;font-weight:400;font-style:normal;color:#222222;font-family:Arial&quot;&gt;Integración: módulo Publicidad y Patrocinios.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#777777;strokeWidth=1.4;fontFamily=Arial;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="2350.0" y="452.0" width="530.0" height="96.0" as="geometry"/></mxCell>
<mxCell id="c159" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:12.5px;font-weight:700;font-style:normal;color:#111111;font-family:Arial&quot;&gt;Proveedor de IA y embeddings&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:10.5px;font-weight:400;font-style:normal;color:#222222;font-family:Arial&quot;&gt;Función: inferencia de modelos de lenguaje y generación de vectores.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:10.5px;font-weight:400;font-style:normal;color:#222222;font-family:Arial&quot;&gt;Integración: módulo Tutor IA y RAG.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:9.5px;font-weight:400;font-style:italic;color:#333333;font-family:Arial&quot;&gt;RAG: solo procesa y recupera contenidos autorizados para los usos correspondientes.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EDEDED;strokeColor=#777777;strokeWidth=1.4;fontFamily=Arial;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="2350.0" y="560.0" width="530.0" height="96.0" as="geometry"/></mxCell>
