<mxCell id="c179" value="Límite de módulo o sistema" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11.5;fontStyle=0;fontColor=#111111;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="108.0" y="1333.9" width="185.4" height="17.2" as="geometry"/></mxCell>
