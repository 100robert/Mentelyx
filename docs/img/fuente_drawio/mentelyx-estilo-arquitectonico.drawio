<mxCell id="c181" value="Sistema externo" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11.5;fontStyle=0;fontColor=#111111;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="108.0" y="1354.9" width="112.0" height="17.2" as="geometry"/></mxCell>
<mxCell id="c182" value="" style="rounded=0;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E6F5F2;strokeColor=#2A9D8F;strokeWidth=1.2;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="1377" width="50" height="14" as="geometry"/></mxCell>
<mxCell id="c183" value="Bloque serverless complementario" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11.5;fontStyle=0;fontColor=#111111;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="108.0" y="1375.9" width="225.4" height="17.2" as="geometry"/></mxCell>
<mxCell id="c184" value="" style="rounded=0;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1.2;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="1210" width="1080" height="200" as="geometry"/></mxCell>
<mxCell id="c185" value="Reglas de la arquitectura" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=14;fontStyle=1;fontColor=#111111;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="632.0" y="1219.3" width="215.0" height="21.0" as="geometry"/></mxCell>
<mxCell id="c186" value="1.  Los módulos se comunican entre sí solo a través de sus services." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12.5;fontStyle=0;fontColor=#111111;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="632.0" y="1246.9" width="505.0" height="18.8" as="geometry"/></mxCell>
<mxCell id="c187" value="2.  Los controllers no acceden directamente a la persistencia." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12.5;fontStyle=0;fontColor=#111111;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="632.0" y="1270.9" width="461.5" height="18.8" as="geometry"/></mxCell>
<mxCell id="c188" value="3.  Los services dependen de interfaces (puertos) de repositorio; las implementaciones con Prisma, MongoDB, Redis y R2 viven en infraestructura." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12.5;fontStyle=0;fontColor=#111111;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="632.0" y="1294.9" width="1056.0" height="18.8" as="geometry"/></mxCell>
<mxCell id="c189" value="4.  Las integraciones externas se realizan mediante adaptadores del backend." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12.5;fontStyle=0;fontColor=#111111;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="632.0" y="1318.9" width="563.0" height="18.8" as="geometry"/></mxCell>
<mxCell id="c190" value="5.  PostgreSQL gestiona lo transaccional; MongoDB, los contenidos flexibles; Redis, la caché; R2, los archivos." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12.5;fontStyle=0;fontColor=#111111;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="632.0" y="1342.9" width="816.8" height="18.8" as="geometry"/></mxCell>
<mxCell id="c191" value="6.  Las funciones serverless son complementarias: no reemplazan al monolito ni concentran las reglas de negocio centrales." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12.5;fontStyle=0;fontColor=#111111;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="632.0" y="1366.9" width="896.5" height="18.8" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>