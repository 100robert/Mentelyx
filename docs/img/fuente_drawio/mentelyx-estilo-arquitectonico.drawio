<mxCell id="c213" value="" style="rounded=0;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=1.5;fontFamily=Arial;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1560.0" y="1290.0" width="1000.0" height="262.0" as="geometry"/></mxCell>
<mxCell id="c214" value="REGLAS ARQUITECTÓNICAS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=14.5;fontStyle=1;fontColor=#111111;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1571.0" y="1302.8" width="218.9" height="21.8" as="geometry"/></mxCell>
<mxCell id="c215" value="1.  Una sola API principal, organizada en siete módulos." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=13;fontStyle=0;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1571.0" y="1338.3" width="336.3" height="19.5" as="geometry"/></mxCell>
<mxCell id="c216" value="2.  Los módulos se estructuran en tres capas." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=13;fontStyle=0;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1571.0" y="1362.8" width="277.0" height="19.5" as="geometry"/></mxCell>
<mxCell id="c217" value="3.  Las dependencias internas siguen Clean Architecture." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=13;fontStyle=0;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1571.0" y="1387.3" width="342.8" height="19.5" as="geometry"/></mxCell>
<mxCell id="c218" value="4.  Los controladores invocan servicios o casos de uso." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=13;fontStyle=0;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1571.0" y="1411.8" width="332.7" height="19.5" as="geometry"/></mxCell>
<mxCell id="c219" value="5.  Los repositorios implementan contratos de persistencia." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=13;fontStyle=0;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1571.0" y="1436.3" width="353.6" height="19.5" as="geometry"/></mxCell>
<mxCell id="c220" value="6.  Los módulos colaboran mediante interfaces públicas." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=13;fontStyle=0;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1571.0" y="1460.8" width="338.5" height="19.5" as="geometry"/></mxCell>
<mxCell id="c221" value="7.  Redis no sustituye a la base de datos transaccional." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=13;fontStyle=0;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1571.0" y="1485.3" width="332.0" height="19.5" as="geometry"/></mxCell>
<mxCell id="c222" value="8.  Los servicios externos se integran por adaptadores." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=13;fontStyle=0;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1571.0" y="1509.8" width="330.5" height="19.5" as="geometry"/></mxCell>
