        </mxCell>
        <mxCell id="111" value="2. Los casos de uso dependen de entidades y contratos, no de adaptadores." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#202B39;fontStyle=0;spacing=0;" vertex="1" parent="1">
