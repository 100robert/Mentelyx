        </mxCell>
        <mxCell id="112" value="3. La infraestructura implementa puertos; es sustituible por contratos." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#202B39;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1483" y="1584" width="748" height="37" as="geometry"/>
        </mxCell>
        <mxCell id="113" value="4. La raíz de composición ensambla dependencias sin contaminar el dominio." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#202B39;fontStyle=0;spacing=0;" vertex="1" parent="1">
