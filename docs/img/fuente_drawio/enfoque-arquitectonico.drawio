        </mxCell>
        <mxCell id="110" value="1. El dominio no importa Hono, Next.js, ORM, MongoDB ni Cloudflare." style="text;html=0;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontColor=#202B39;fontStyle=0;spacing=0;" vertex="1" parent="1">
