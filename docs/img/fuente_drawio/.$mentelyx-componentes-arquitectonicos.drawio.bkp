<mxCell id="c161" value="1.  Los siete módulos comparten una API desplegable." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=12;fontStyle=0;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="869.0" y="1603.4" width="304.2" height="18.0" as="geometry"/></mxCell>
<mxCell id="c162" value="2.  Cada módulo expone contratos internos, no tablas privadas." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=12;fontStyle=0;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="869.0" y="1629.4" width="350.9" height="18.0" as="geometry"/></mxCell>
<mxCell id="c163" value="3.  Las dependencias siguen los principios de Clean Architecture." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=12;fontStyle=0;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="869.0" y="1655.4" width="360.9" height="18.0" as="geometry"/></mxCell>
<mxCell id="c164" value="4.  PostgreSQL conserva operaciones transaccionales críticas." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=12;fontStyle=0;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="869.0" y="1681.4" width="347.7" height="18.0" as="geometry"/></mxCell>
<mxCell id="c165" value="5.  Los proveedores externos se integran mediante adaptadores." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=12;fontStyle=0;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="869.0" y="1707.4" width="358.2" height="18.0" as="geometry"/></mxCell>
