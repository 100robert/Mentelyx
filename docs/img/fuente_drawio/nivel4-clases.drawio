<mxCell id="c236" value="Columnas = capas · Recuadro punteado gris = módulo · «interface», «entity», «value object», «domain service» = estereotipos UML.  Los puertos se declaran en Aplicación; los adaptadores los realizan desde Infraestructura." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=16.5;fontStyle=0;fontColor=#5B6B80;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="59.0" y="2367.7" width="1651.7" height="24.8" as="geometry"/></mxCell>
