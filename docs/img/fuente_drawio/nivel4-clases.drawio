<mxCell id="c99" value="&lt;div style=&quot;text-align:left;padding-left:16px;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:16px;font-weight:400;font-style:normal;color:#2D3748;font-family:Arial&quot;&gt;Los resultados confirmados se almacenan en PostgreSQL, fuente de&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;padding-left:16px;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:16px;font-weight:400;font-style:normal;color:#2D3748;font-family:Arial&quot;&gt;verdad del módulo.&lt;/span&gt;&lt;/div&gt;" style="rounded=0;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFDF0;strokeColor=#9A8F5B;strokeWidth=1.4;fontFamily=Arial;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2410.0" y="620.0" width="560.0" height="68.0" as="geometry"/></mxCell>
