<mxCell id="c129" value="Reglas de dependencia" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=15;fontStyle=1;fontColor=#111111;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1021.0" y="1242.2" width="180.7" height="22.5" as="geometry"/></mxCell>
<mxCell id="c130" value="1.  El dominio no importa frameworks ni infraestructura." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=13;fontStyle=0;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1021.0" y="1278.3" width="332.6" height="19.5" as="geometry"/></mxCell>
<mxCell id="c131" value="2.  Los casos de uso ejecutan reglas y dependen de puertos." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=13;fontStyle=0;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1021.0" y="1306.3" width="365.2" height="19.5" as="geometry"/></mxCell>
<mxCell id="c132" value="3.  Los adaptadores implementan contratos internos." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=13;fontStyle=0;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1021.0" y="1334.3" width="317.5" height="19.5" as="geometry"/></mxCell>
<mxCell id="c133" value="4.  La raíz de composición inyecta las implementaciones." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=13;fontStyle=0;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1021.0" y="1362.3" width="342.8" height="19.5" as="geometry"/></mxCell>
<mxCell id="c134" value="5.  Los siete módulos pertenecen a un monolito modular." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=13;fontStyle=0;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1021.0" y="1390.3" width="340.6" height="19.5" as="geometry"/></mxCell>
<mxCell id="c135" value="Cada módulo aplica estas cuatro responsabilidades por dentro; los módulos colaboran mediante contratos públicos." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontSize=11;fontStyle=0;fontColor=#555555;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1021.0" y="1440.5" width="578.4" height="16.5" as="geometry"/></mxCell>
