{
  // Worker del frontend (Next.js + OpenNext, ADR-074). Local: `pnpm build:worker` y `pnpm preview` (puerto 8788).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mentelyx-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [
    // Revalidación ISR (memory queue de OpenNext).
    { "binding": "WORKER_SELF_REFERENCE", "service": "mentelyx-web" },
    // API Hono (backend/wrangler.jsonc): /api/v1/* se reenvía por este enlace interno, sin salir a Internet.
    { "binding": "API", "service": "mentelyx-api" }
  ],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "mentelyx-web-opennext-cache" }],
  "observability": { "enabled": true }
}
