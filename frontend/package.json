{
  "name": "@mentelyx/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Aplicación web/PWA de Mentelyx: Next.js híbrido en Cloudflare Workers mediante OpenNext (ADR-074)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc -p tsconfig.json",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv"
  },
  "dependencies": {
    "@mentelyx/contratos": "workspace:*",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.18",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "wrangler": "4.166.0"
  }
}
