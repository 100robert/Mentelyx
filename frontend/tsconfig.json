{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] },
    "types": ["./cloudflare-env.d.ts", "node"]
  },
  "include": ["next-env.d.ts", "src", "next.config.ts", "open-next.config.ts", "cloudflare-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".open-next", ".next/dev"]
}
