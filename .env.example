# Valores locales y sintéticos para Docker Compose. Copiar a .env solo en desarrollo. Nunca credenciales reales.
DATABASE_URL=postgres://mentelyx:mentelyx_local@127.0.0.1:55432/mentelyx
# Proxy WebSocket de Neon (driver serverless) contra el PostgreSQL local
NEON_WS_PROXY=127.0.0.1:5488
MONGODB_URL=mongodb://127.0.0.1:57017
UPSTASH_REDIS_REST_URL=http://127.0.0.1:8079
UPSTASH_REDIS_REST_TOKEN=token_local_mentelyx
